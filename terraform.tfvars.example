# Copy this file to terraform.tfvars and fill in your values.
# terraform.tfvars is git-ignored so your settings stay private.

aws_region       = "ap-south-1"
project_name     = "devops-demo"
environment      = "dev"
allowed_ssh_cidr = "203.0.113.10/32" # replace with your IP: curl ifconfig.me
key_name         = "my-keypair"      # an existing EC2 key pair in this region
instance_count   = 1

# Do NOT put db_password here. Export it instead:
#   export TF_VAR_db_password='YourStrongPassword123!'
